	goodix_fp: fingerprint {
		compatible = "mediatek,goodix-fp";
		interrupt-parent = <&pio>;
		interrupts = <9 IRQ_TYPE_EDGE_RISING>;
		pinctrl-names = "fingerprint_irq", "power_high", "power_low", "reset_high", "reset_low";
		pinctrl-0 = <&fingerprint_irq>;
		pinctrl-1 = <&fingerprint_power_high>;
		pinctrl-2 = <&fingerprint_power_low>;
		pinctrl-3 = <&fingerprint_reset_high>;
		pinctrl-4 = <&fingerprint_reset_low>;
		status = "okay";
	};

	vs1_wire: vs1_wire {
		compatible = "amazon,vs1_wire", "simple-bus";
		status = "okay";

		virtual_sensor@0 {
			compatible = "amazon,virtual_sensor-thermal";
			dev_id = <0>;
			num_trips = <9>;
			mode = <0>;
			polling_delay = <3000>;
			governor_name = "virtual_sensor";
			num_tbps = <3>;
			temp = <44500 45000 47000 49000 50000 52000 54000 55000 56000 56000 56000 56000>;
			type = <1 1 1 1 1 1 1 1 3 3 3 3>;
			hyst = <3000 0 0 0 0 0 0 3000 0 0 0 0>;
			num_cdevs = <3>;
			cdev_names = "thermal_budget0", "lcd-backlight0", "devfreq_gpu0";
		};

		backlight@0 {
			compatible = "amazon,backlight_cooler";
			type = "lcd-backlight0";
			state = <0>;
			max_state = <12>;
			level = <255>;
			thermal_cooler_id = <1>;
			levels = <255 255 255 255 255 126 76 76 76 76 76 76>;
		};

		thermal_budget@0 {
			compatible = "amazon,thermal_budget_cooler";
			type = "thermal_budget0";
			state = <0>;
			max_state = <12>;
			level = <4600>;
			thermal_cooler_id = <2>;
			levels = <1672 1560 1560 1422 1224 1022 786 786 544 544 544 544>;
		};

		devfreq_gpu@0 {
			compatible = "amazon,devfreq_cooler";
			type = "devfreq_gpu0";
			state = <0>;
			max_state = <12>;
			level = <950000000>;
			thermal_cooler_id = <4>;
			devfreq = <&mali>;
			levels = <950000000 950000000 950000000 950000000 950000000 950000000 950000000 950000000
			          950000000 950000000 950000000 950000000>;
		};

		thermal_pmic@0 {
			compatible = "amazon,virtual_sensor_thermal_sensor";
			thermal_sensor,offset = <24500>;
			thermal_sensor,alpha = <987>;
			thermal_sensor,weight = <141>;
			thermal_sensor,weight_invert = <0>;
			thermal_sensor,offset_invert = <0>;
			thermal_sensor_id = <3>;
			aux_channel_num = <0>;
			select_device = <0>;
		};

		thermistor_ap_ntc@00 {
			compatible = "amazon,virtual_sensor_thermal_sensor";
			thermal_sensor,offset = <47300>;
			thermal_sensor,offset_invert = <0>;
			thermal_sensor,alpha = <417>;
			thermal_sensor,weight = <0>;
			thermal_sensor,weight_invert = <0>;
			thermal_sensor_id = <5>;
			aux_channel_num = <0>;
			select_device = <0>;
		};

		thermistor_sdcard_ntc@01 {
			compatible = "amazon,virtual_sensor_thermal_sensor";
			thermal_sensor,offset = <22300>;
			thermal_sensor,offset_invert = <0>;
			thermal_sensor,alpha = <716>;
			thermal_sensor,weight = <355>;
			thermal_sensor,weight_invert = <0>;
