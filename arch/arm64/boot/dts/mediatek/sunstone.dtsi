&reserved_memory {
	mdump-reserved-memory@0x7d2c0000 {
		compatible = "amazon,mdump-reserve-memory";
		reg = <0 0x7d2c0000 0 0x40000>;
	};
};

&afe {
	mediatek,memif_force_sram = <6 15>;
	assigned-clocks = <&topckgen CLK_TOP_AUD_INTBUS_SEL>,
	                  <&topckgen CLK_TOP_A1SYS_HP_SEL>,
	                  <&topckgen CLK_TOP_A2SYS_SEL>,
	                  <&topckgen CLK_TOP_A3SYS_SEL>,
	                  <&topckgen CLK_TOP_A4SYS_SEL>;
	assigned-clock-parents = <&clk26m>,
	                         <&clk26m>,
	                         <&clk26m>,
	                         <&clk26m>,
	                         <&clk26m>;
	status = "okay";
};

&accdet {
	accdet-mic-mode = <1>;
	was4780_audio_switch = <&audio_switch>;
	headset-use-ap-eint = <1>;
	mic_voltage_delay = <20>;
	switch-mode-vol = <521>;
	status = "okay";
};

&pdc {
	status = "disabled";
	pd_vbus_upper_bound = <9000000>;
	pd_hv_input_current_limit = <1700000>;
};

&pd_adapter {
	status = "disabled";
};

&apu_iommu0 {
	status = "okay";
};

&apu_iommu1 {
	status = "okay";
};

&apu_top_3 {
	vapu-supply = <&mt6359_vmodem_reg>;
	vsram-supply = <&mt6359_vsram_md_reg>;
	operating-points-v2 = <&opp_table_apu_conn &opp_table_apu_rv &opp_table_vpu &opp_table_dla>;
	status = "okay";
};

&apusys_hw_logger {
	status = "okay";
};

&apusys_reviser {
	status = "okay";
};

&apusys_rv {
	status = "okay";
};

&auxadc {
	status = "okay";
};

&cam_vcore {
	domain-supply = <&mt6359_vproc1_reg>;
};

&ccu_rproc {
	secured = "no";
};

&chosen {
	bootargs_ext = "clk_ignore_unused pd_ignore_unused";
};

&ddr_emi {
	dvfsrc-helper {
		vcore-supply = <&mt6359_vgpu11_reg>;
		status = "okay";
	};
};

&disp_dpi1 {
	status = "okay";

	port {

		dpi1_out: endpoint@0 {
			remote-endpoint = <&hdmi0_in>;
		};
	};
};

&disp_dsi0 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&panel_pins_default>;

	panel@0 {
		compatible = "panel,ft8205_wuxga_dsi_vdo";
		reg = <0>;
		enable-gpios = <&pio 25 GPIO_ACTIVE_HIGH>;
		leden-gpios = <&pio 144 GPIO_ACTIVE_HIGH>;
		avdd-gpios = <&pio 130 GPIO_ACTIVE_HIGH>;
		avee-gpios = <&pio 129 GPIO_ACTIVE_HIGH>;
		ctp-rst-gpio = <&pio 5 GPIO_ACTIVE_HIGH>;
		pp1800-supply = <&mt6359_vrf18_reg>;
		status = "okay";

		port {

			panel_in: endpoint {
				remote-endpoint = <&dsi_out>;
			};
		};
	};

	panel@2 {
		compatible = "panel,nt36523b_wuxga_dsi_vdo";
		reg = <0x2>;
		enable-gpios = <&pio 25 GPIO_ACTIVE_HIGH>;
		leden-gpios = <&pio 144 GPIO_ACTIVE_HIGH>;
		avdd-gpios = <&pio 130 GPIO_ACTIVE_HIGH>;
		avee-gpios = <&pio 129 GPIO_ACTIVE_HIGH>;
		ctp-rst-gpios = <&pio 5 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&te_pins_default>;
		pp1800-supply = <&mt6359_vrf18_reg>;
		status = "okay";

		port {

			panel2_in: endpoint {
				remote-endpoint = <&dsi2_out>;
			};
		};
	};

	panel@3 {
		compatible = "panel,ili9882t_wuxga_dsi_vdo";
		reg = <0x3>;
		enable-gpios = <&pio 25 GPIO_ACTIVE_HIGH>;
		leden-gpios = <&pio 144 GPIO_ACTIVE_HIGH>;
		avdd-gpios = <&pio 130 GPIO_ACTIVE_HIGH>;
		avee-gpios = <&pio 129 GPIO_ACTIVE_HIGH>;
		ctp-rst-gpios = <&pio 5 GPIO_ACTIVE_HIGH>;
		pp1800-supply = <&mt6359_vrf18_reg>;
		status = "okay";

		port {

			panel3_in: endpoint {
				remote-endpoint = <&dsi3_out>;
			};
		};
	};

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;

			dsi_out: endpoint {
				remote-endpoint = <&panel_in>;
			};
		};

		port@2 {
			reg = <0x2>;

			dsi2_out: endpoint {
				remote-endpoint = <&panel2_in>;
			};
		};

		port@3 {
			reg = <0x3>;

			dsi3_out: endpoint {
				remote-endpoint = <&panel3_in>;
			};
		};
	};
};

&dsi_te {
	interrupt-parent = <&pio>;
	interrupts = <26 IRQ_TYPE_EDGE_RISING>;
	status = "okay";
};

&disp_pwm0 {
	pinctrl-names = "default";
	pinctrl-0 = <&pwm0_gpio_def_cfg>;
	status = "okay";
};

&odm {
	keycombo@1 {
		compatible = "amzn,keycombo";
		keys_down = "KEY_POWER";
		keys_down_delay = <6000>;
		keys_down_func = <1>;
		status = "okay";
	};

	ld {
		compatible = "amzn,ld";
		status = "okay";
		work_interval = <15 30 60>;
		threshold = <120 1450>;
		gpio_reverse_ctrl;
		io-channels = <&auxadc 1>;
		io-channel-names = "ld_adc_channel";
		pinctrl-names = "ldctrl1_init", "ldctrl1_low", "ldctrl1_high",
		                "lddetection1_init", "lddetection1_low",
		                "lddetection1_high", "lddetection2_init",
		                "lddetection2_low", "lddetection2_high";
		pinctrl-0 = <&ld_ctrl1_init>;
		pinctrl-1 = <&ld_ctrl1_low>;
		pinctrl-2 = <&ld_ctrl1_high>;
		pinctrl-3 = <&ld_detection1_init>;
		pinctrl-4 = <&ld_detection1_low>;
		pinctrl-5 = <&ld_detection1_high>;
		pinctrl-6 = <&ld_detection2_init>;
		pinctrl-7 = <&ld_detection2_low>;
		pinctrl-8 = <&ld_detection2_high>;
		liquid-id = <&pio 17 0>;
	};

	pubadc {
		compatible = "amzn,pubadc";
		pubadc-id = <&pio 17 0>;
		pinctrl-names = "pubadc_bat_id", "pubadc_liquid";
		pinctrl-0 = <&public_adc_bat_id>;
		pinctrl-1 = <&public_adc_liquid>;
		io-channels = <&auxadc 1>;
		io-channel-names = "pubadc_adc_channel";
		pubadc_dts_id = [00];
	};
};

&eth {
	phy-mode = "rgmii-rxid";
	phy-handle = <&eth_phy0>;
	snps,reset = <&pio 147 0>;
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&eth_default>;
	pinctrl-1 = <&eth_sleep>;
	status = "disabled";

	mdio {
		compatible = "snps,dwmac-mdio";
		#address-cells = <1>;
		#size-cells = <0>;

		eth_phy0: eth_phy0@1 {
			compatible = "ethernet-phy-id001c.c916";
			reg = <0x1>;
		};

		eth_phy1: eth_phy2@4 {
			compatible = "ethernet-phy-id001c.c816";
			reg = <0x4>;
		};
	};
};

&gpufreq {
	vgpu-supply = <&mt6359_vproc2_reg>;
	vsram_gpu-supply = <&mt6359_vsram_others_reg>;
};

&hdmi0 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;

			hdmi0_in: endpoint {
				remote-endpoint = <&dpi1_out>;
			};
		};
	};
};

&hifidsp_audio_ipi {
	status = "disabled";
};

&i2c0 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0_pin>;
	clock-frequency = <400000>;
	status = "okay";
};

&i2c1 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1_pin>;
	clock-frequency = <400000>;
	status = "okay";

	fusb251@28 {
		status = "ok";
		compatible = "fusb251";
		reg = <0x28>;
		i2c_num = <1>;
		i2c_addr = <0x28 0 0 0>;
		threshold_sbu = <747 960>;
		threshold_sbuft = <100>;
		work_interval = <15 30 60>;
		det_delay = <100 1000>;
	};

	max20342@35 {
		status = "ok";
		compatible = "max20342";
		reg = <0x35>;
		i2c_num = <1>;
		i2c_addr = <0x35 0 0 0>;
		work_interval = <15 30 60>;
		det_delay = <300 300>;
		target_ipu = [01];
		target_resister = [64];
		ld_buffer = [56 77];
		target_voltage_max = [a3];
		target_adcgroundvth = [04];
		pinctrl-names = "mosctrl1_init", "mosctrl1_low", "mosctrl1_high",
		                "mosctrl2_init", "mosctrl2_low", "mosctrl2_high";
		pinctrl-0 = <&mos_ctrl1_init>;
		pinctrl-1 = <&mos_ctrl1_low>;
		pinctrl-2 = <&mos_ctrl1_high>;
		pinctrl-3 = <&mos_ctrl2_init>;
		pinctrl-4 = <&mos_ctrl2_low>;
		pinctrl-5 = <&mos_ctrl2_high>;
	};
};

&i2c2 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c2_pin>;
	clock-frequency = <1000000>;
	status = "okay";

	rt1711h: usb_type_c0@4e {
		compatible = "mediatek,usb_type_c";
		reg = <0x4e>;
		status = "okay";
		interrupts-extended = <&pio 0 IRQ_TYPE_LEVEL_LOW>;

		port {

			tcpc_typec_usb: endpoint@0 {
				remote-endpoint = <&ssusb_mux>;
			};
		};
	};
};

&i2c3 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c3_pin>;
	clock-frequency = <400000>;
	status = "okay";

	alsps@53 {
		compatible = "mediatek,alsps";
		reg = <0x53>;
		interrupt-parent = <&pio>;
		interrupts = <11 IRQ_TYPE_LEVEL_LOW>;
		debounce = <11 0>;
		pinctrl-names = "pin_default", "pin_cfg";
		pinctrl-0 = <&alsps_intpin_default>;
		pinctrl-1 = <&alsps_intpin_cfg>;
		status = "okay";
		i2c_num = <2>;
		i2c_addr = <0x53 0 0 0>;
		polling_mode_ps = <0>;
		polling_mode_als = <1>;
		power_id = <0xffff>;
		power_vol = <0>;
		cal_factoy = <437 475 475 584>;
		als_level = <0 1 1 7 15 15 100 1000 2000 3000 6000 10000 14000 18000 20000>;
		als_value = <40 40 90 90 160 160 225 320 640 1280 1280 2600 2600 2600 10240 10240>;
		ps_threshold_high = <900>;
		ps_threshold_low = <600>;
		is_batch_supported_ps = <0>;
		is_batch_supported_als = <0>;
	};

	lp8556@2c {
		compatible = "lp8556";
		reg = <0x2c>;
	};

	mp3314@28 {
		compatible = "mp3314";
		reg = <0x28>;
	};

	sy7758@2e {
		compatible = "sy7758";
		reg = <0x2e>;
	};

	bias_ic@3e {
		compatible = "lcm_bias";
		reg = <0x3e>;
	};

	gsensor1: gsensor@4c {
		compatible = "mediatek,mc3416";
		reg = <0x4c>;
		status = "okay";
		i2c_num = <2>;
		i2c_addr = <0x4c 0 0 0>;
		direction = <2>;
		power_id = <0xffff>;
		power_vol = <0>;
		firlen = <0>;
		is_batch_supported = <0>;
	};

	audio_switch: was4780@42 {
		compatible = "willsemi,was4780-i2c";
		reg = <0x42>;
#ifdef SUNSTONE_MOISTURE_DETECT
		pinctrl-names = "mosit_det_on", "mosit_det_off";
		pinctrl-0 = <&mosit_pins_det_on>;
		pinctrl-1 = <&mosit_pins_det_off>;
#endif
	};

	gsensor2: gsensor@18 {
		compatible = "mediatek,stk8ba58";
		reg = <0x18>;
		status = "okay";
		i2c_num = <2>;
		i2c_addr = <0x18 0 0 0>;
		direction = <2>;
		power_id = <0xffff>;
		power_vol = <0>;
		firlen = <0>;
		is_batch_supported = <0>;
	};
};

&i2c4 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c4_pin>;
	clock-frequency = <1000000>;
	status = "okay";

	husb311@4e {
		compatible = "hynetek,husb311";
		reg = <0x4e>;
		status = "okay";
		interrupt-parent = <&pio>;
	};
};

&i2c5 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c5_pin>;
	clock-frequency = <400000>;
	status = "okay";
};

&i2c6 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c6_pin>;
	clock-frequency = <400000>;
	status = "okay";
};

&img_vcore {
	domain-supply = <&mt6359_vproc1_reg>;
};

&vmmspm {
	buck-vmm-supply = <&mt6359_vproc1_reg>;
	status = "okay";
};

&ispdvfs {
	buck-vmm-supply = <&mt6359_vproc1_reg>;
	status = "okay";
};

&mdla {
	status = "okay";
};

&mdla_devfreq {
	power_table = <667 583 423 296 189 145 92>;
	status = "okay";
};

&mfg0 {
	domain-supply = <&mt6359_vproc2_reg>;
};

&mipi_tx_config0 {
	status = "okay";
};

&mmc0 {
	status = "okay";
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc0_pins_default>;
	pinctrl-1 = <&mmc0_pins_uhs>;
	bus-width = <8>;
	max-frequency = <200000000>;
	cap-mmc-highspeed;
	mmc-hs200-1_8v;
	mmc-hs400-1_8v;
	mmc-hs400-enhanced-strobe;
	supports-cqe;
	cap-mmc-hw-reset;
	no-sdio;
	no-sd;
	hs400-ds-delay = <83995>;
	vmmc-supply = <&mt6359_vemc_reg>;
	vqmmc-supply = <&mt6359_vufs_reg>;
	non-removable;
};

&mmc1 {
	status = "okay";
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc1_pins_default>;
	pinctrl-1 = <&mmc1_pins_uhs>;
	bus-width = <4>;
	max-frequency = <200000000>;
	cap-sd-highspeed;
	sd-uhs-sdr50;
	sd-uhs-sdr104;
	no-mmc;
	no-sdio;
	cd-gpios = <&pio 2 GPIO_ACTIVE_HIGH>;
	vmmc-supply = <&mt6359_vpa_reg>;
	vqmmc-supply = <&mt6359_vsim1_reg>;
};

&mt6359_vpa_reg {
	regulator-max-microvolt = <3100000>;
};

&mtk_apu_mem_code {
	status = "okay";
};

&mtk_apu_mem_data {
	status = "okay";
};

&mt6359_vmodem_reg {
	regulator-always-on;
};

&mt6359_vrf18_reg {
	regulator-min-microvolt = <1800000>;
	regulator-max-microvolt = <1800000>;
};

&mt6359_vsram_md_reg {
	regulator-always-on;
};

&mt6359_vsim2_reg {
	regulator-min-microvolt = <3000000>;
};

&wifi_pwrseq {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&wifi_pins_pwrseq>;
	reset-gpios = <&pio 71 GPIO_ACTIVE_LOW>;
	post-power-on-delay-ms = <200>;
};

&mmc2 {
	status = "okay";
	pinctrl-names = "default", "state_uhs", "state_eint", "state_dat1", "state_low";
	pinctrl-0 = <&mmc2_pins_default>;
	pinctrl-1 = <&mmc2_pins_uhs>;
	pinctrl-2 = <&mmc2_pins_eint>;
	pinctrl-3 = <&mmc2_pins_dat1>;
	pinctrl-4 = <&mmc2_pins_all_low>;
	eint-gpios = <&pio 172 GPIO_ACTIVE_HIGH>;
	bus-width = <4>;
	max-frequency = <200000000>;
	cap-sd-highspeed;
	sd-uhs-sdr104;
	dvfsrc-vcore-supply = <&dvfsrc_vcore>;
	max-vcore-volt = <725000>;
	keep-power-in-suspend;
	cap-sdio-async-int;
	cap-sdio-irq;
	no-mmc;
	no-sd;
	non-removable;
	vmmc-supply = <&sdio_fixed_3v3>;
	vqmmc-supply = <&sdio_fixed_1v8>;
	mmc-pwrseq = <&wifi_pwrseq>;
};

&mt6359codec {
	mediatek,mic-type-0 = <3>;
	mediatek,mic-type-1 = <1>;
	mediatek,mic-type-2 = <3>;
};

