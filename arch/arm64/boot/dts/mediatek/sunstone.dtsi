&thermal_zones {
	ap_ntc {
		polling-delay = <1000>;
		polling-delay-passive = <1000>;
		thermal-sensors = <&tboard_thermistor1>;

		trips {

			ap_ntc_sysrst: ap_ntc_sysrst@0 {
				temperature = <75000>;
				hysteresis = <0>;
				type = "active";
			};

			ap_ntc_crit: ap_ntc_crit@0 {
				temperature = <70000>;
				hysteresis = <0>;
				type = "critical";
			};
		};

		cooling-maps {

			map0 {
				trip = <&ap_ntc_sysrst>;
				cooling-device = <&sysrst_cooling THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
			};
		};
	};

	pmic_temp {
		polling-delay = <1000>;
		polling-delay-passive = <1000>;
		thermal-sensors = <&pmic_temp 0>;

		trips {

			pmic_temp_sysrst: pmic_temp_sysrst@0 {
				temperature = <120000>;
				hysteresis = <0>;
				type = "active";
			};

			pmic_temp_crit: pmic_temp_crit@0 {
				temperature = <118000>;
				hysteresis = <0>;
				type = "critical";
			};
		};

		cooling-maps {

			map0 {
				trip = <&pmic_temp_sysrst>;
				cooling-device = <&sysrst_cooling THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
			};
		};
	};

	pmic_vcore {
		polling-delay = <0>;
		polling-delay-passive = <0>;
		thermal-sensors = <&pmic_temp 1>;
	};

	pmic_vproc {
		polling-delay = <0>;
		polling-delay-passive = <0>;
		thermal-sensors = <&pmic_temp 2>;
	};

	pmic_vgpu {
		polling-delay = <0>;
		polling-delay-passive = <0>;
		thermal-sensors = <&pmic_temp 3>;
	};

	sdcard_ntc {
		polling-delay = <1000>;
		polling-delay-passive = <1000>;
		thermal-sensors = <&tboard_thermistor2>;

		trips {

			sdcard_ntc_sysrst: sdcard_ntc_sysrst@0 {
				temperature = <70000>;
				hysteresis = <0>;
				type = "active";
			};

			sdcard_ntc_crit: sdcard_ntc_crit@0 {
				temperature = <65000>;
				hysteresis = <0>;
				type = "critical";
			};
		};

		cooling-maps {

			map0 {
				trip = <&sdcard_ntc_sysrst>;
				cooling-device = <&sysrst_cooling THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
			};
		};
	};

	pm6365_ntc {
		polling-delay = <1000>;
		polling-delay-passive = <1000>;
		thermal-sensors = <&tboard_thermistor3>;

		trips {

			pm6365_ntc_sysrst: pm6365_ntc_sysrst@0 {
				temperature = <75000>;
				hysteresis = <0>;
				type = "active";
			};

			pm6365_ntc_crit: pm6365_ntc_crit@0 {
				temperature = <70000>;
				hysteresis = <0>;
				type = "critical";
			};
		};

		cooling-maps {

			map0 {
				trip = <&pm6365_ntc_sysrst>;
				cooling-device = <&sysrst_cooling THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
			};
		};
	};

	usb_ntc {
		polling-delay = <1000>;
		polling-delay-passive = <1000>;
		thermal-sensors = <&tboard_thermistor4>;
	};

	charge_ntc {
		polling-delay = <1000>;
		polling-delay-passive = <1000>;
		thermal-sensors = <&tboard_thermistor5>;

		trips {

			charge_ntc_sysrst: charge_ntc_sysrst@0 {
				temperature = <75000>;
				hysteresis = <0>;
				type = "active";
			};

			charge_ntc_crit: charge_ntc_crit@0 {
				temperature = <70000>;
				hysteresis = <0>;
				type = "critical";
			};
		};

		cooling-maps {

			map0 {
				trip = <&charge_ntc_sysrst>;
				cooling-device = <&sysrst_cooling THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
			};
		};
	};

	mtk-master-charger {
		polling-delay-passive = <3000>;
		polling-delay = <3000>;
		thermal-sensors = <&charger>;

		trips {

			mtk_charger_sysrst: mtk_charger_sysrst@0 {
				temperature = <120000>;
				hysteresis = <0>;
				type = "active";
			};

			mtk_master_charger_max_crit: mtk_master_charger_max_crit@0 {
				temperature = <118000>;
				hysteresis = <0>;
				type = "critical";
			};
		};

		cooling-maps {

			map0 {
				trip = <&mtk_charger_sysrst>;
				cooling-device = <&sysrst_cooling THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
			};
		};
	};

	consys {
		polling-delay = <1000>;
		polling-delay-passive = <1000>;
		thermal-sensors = <&consys>;

		trips {

			consys_max_sysrst: consys_max_sysrst@0 {
				temperature = <115000>;
				hysteresis = <2000>;
				type = "active";
			};

			consys_max_crit: consys_max_crit@0 {
				temperature = <113000>;
				hysteresis = <2000>;
				type = "critical";
			};
		};

		cooling-maps {

			map0 {
				trip = <&consys_max_sysrst>;
				cooling-device = <&sysrst_cooling THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
			};
		};
	};
};

