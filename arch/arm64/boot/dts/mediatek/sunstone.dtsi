&pio {
	camera_pins_cam0_rst_0: cam0@0 {

		pins_cmd_dat {
			pinmux = <PINMUX_GPIO19__FUNC_B_GPIO19>;
			bias-disable;
			output-low;
		};
	};

	camera_pins_cam0_rst_1: cam0@1 {

		pins_cmd_dat {
			pinmux = <PINMUX_GPIO19__FUNC_B_GPIO19>;
			bias-disable;
			output-high;
		};
	};

	camera_pins_cam0_pnd_0: cam0@2 {

		pins_cmd_dat {
			pinmux = <PINMUX_GPIO18__FUNC_B_GPIO18>;
			bias-disable;
			output-low;
		};
	};

	camera_pins_cam0_pnd_1: cam0@3 {

		pins_cmd_dat {
			pinmux = <PINMUX_GPIO18__FUNC_B_GPIO18>;
			bias-disable;
			output-high;
		};
	};

	camera_pins_cam1_rst_0: cam1@0 {

		pins_cmd_dat {
			pinmux = <PINMUX_GPIO21__FUNC_B_GPIO21>;
			bias-disable;
			output-low;
		};
	};

	camera_pins_cam1_rst_1: cam1@1 {

		pins_cmd_dat {
			pinmux = <PINMUX_GPIO21__FUNC_B_GPIO21>;
			bias-disable;
			output-high;
		};
	};

	camera_pins_cam0_vcamd_0: cam0@vcam0 {

		pins_cmd_dat {
			pinmux = <PINMUX_GPIO111__FUNC_B_GPIO111>;
			bias-disable;
			output-low;
		};
	};

	camera_pins_cam0_vcamd_1: cam0@vcam1 {

		pins_cmd_dat {
			pinmux = <PINMUX_GPIO111__FUNC_B_GPIO111>;
			bias-disable;
			output-high;
		};
	};

	camera_pins_cam0_vcama_0: cam0@vcam2 {

		pins_cmd_dat {
			pinmux = <PINMUX_GPIO110__FUNC_B_GPIO110>;
			bias-disable;
			output-low;
		};
	};

	camera_pins_cam0_vcama_1: cam0@vcam3 {

		pins_cmd_dat {
			pinmux = <PINMUX_GPIO110__FUNC_B_GPIO110>;
			bias-disable;
			output-high;
		};
	};

	camera_pins_cam1_vcamd_0: cam1@vcam0 {

		pins_cmd_dat {
			pinmux = <PINMUX_GPIO111__FUNC_B_GPIO111>;
			bias-disable;
			output-low;
		};
	};

	camera_pins_cam1_vcamd_1: cam1@vcam1 {

		pins_cmd_dat {
			pinmux = <PINMUX_GPIO111__FUNC_B_GPIO111>;
			bias-disable;
			output-high;
		};
	};

	camera_pins_cam1_vcama_0: cam1@vcam2 {

		pins_cmd_dat {
			pinmux = <PINMUX_GPIO110__FUNC_B_GPIO110>;
			bias-disable;
			output-low;
		};
	};

	camera_pins_cam1_vcama_1: cam1@vcam3 {

		pins_cmd_dat {
			pinmux = <PINMUX_GPIO110__FUNC_B_GPIO110>;
			bias-disable;
			output-high;
		};
	};

	camera_pins_cam0_mclk_off: camera_pins_cam0_mclk_off {

		pins_cmd_dat {
			pinmux = <PINMUX_GPIO22__FUNC_B_GPIO22>;
			output-low;
		};
	};

	camera_pins_cam0_mclk_2ma: camera_pins_cam0_mclk_2ma {

		pins_cmd_dat {
			pinmux = <PINMUX_GPIO22__FUNC_O_CMMCLK0>;
			drive-strength = <2>;
		};
	};

	camera_pins_cam0_mclk_4ma: camera_pins_cam0_mclk_4ma {

		pins_cmd_dat {
			pinmux = <PINMUX_GPIO22__FUNC_O_CMMCLK0>;
			drive-strength = <4>;
		};
	};

	camera_pins_cam0_mclk_6ma: camera_pins_cam0_mclk_6ma {

		pins_cmd_dat {
			pinmux = <PINMUX_GPIO22__FUNC_O_CMMCLK0>;
			drive-strength = <6>;
		};
	};

	camera_pins_cam0_mclk_8ma: camera_pins_cam0_mclk_8ma {

		pins_cmd_dat {
			pinmux = <PINMUX_GPIO22__FUNC_O_CMMCLK0>;
			drive-strength = <8>;
		};
	};

	camera_pins_cam1_mclk_off: camera_pins_cam1_mclk_off {

		pins_cmd_dat {
			pinmux = <PINMUX_GPIO23__FUNC_B_GPIO23>;
			output-low;
		};
	};

	camera_pins_cam1_mclk_2ma: camera_pins_cam1_mclk_2ma {

		pins_cmd_dat {
			pinmux = <PINMUX_GPIO23__FUNC_O_CMMCLK1>;
			drive-strength = <2>;
		};
	};

	camera_pins_cam1_mclk_4ma: camera_pins_cam1_mclk_4ma {

		pins_cmd_dat {
			pinmux = <PINMUX_GPIO23__FUNC_O_CMMCLK1>;
			drive-strength = <4>;
		};
	};

	camera_pins_cam1_mclk_6ma: camera_pins_cam1_mclk_6ma {

		pins_cmd_dat {
			pinmux = <PINMUX_GPIO23__FUNC_O_CMMCLK1>;
			drive-strength = <6>;
		};
	};

	camera_pins_cam1_mclk_8ma: camera_pins_cam1_mclk_8ma {

		pins_cmd_dat {
			pinmux = <PINMUX_GPIO23__FUNC_O_CMMCLK1>;
			drive-strength = <8>;
		};
	};
};

&i2c5 {
	mtk_camera_eeprom1: camera_eeprom1@51 {
		compatible = "mediatek,camera_eeprom";
		reg = <0x51>;
		status = "okay";
	};
};

&i2c6 {
	mtk_camera_eeprom0: camera_eeprom0@50 {
		compatible = "mediatek,camera_eeprom";
		reg = <0x50>;
		status = "okay";
	};
};

&i2c6 {
	camera_af_main@0c {
		compatible = "mediatek,gt9772s";
		reg = <0xc>;
		vin-supply = <&mt6359_vibr_reg>;

		port {

			main_af: endpoint {
				remote-endpoint = <&main_af_endpoint>;
			};
		};
	};

	camera_af_main1@0d {
		compatible = "mediatek,gt9769";
		reg = <0xd>;
		vin-supply = <&mt6359_vibr_reg>;

		port {

			main_af1: endpoint {
				remote-endpoint = <&main_af1_endpoint>;
			};
		};
	};
};

&mtk_composite_v4l2_2 {
	port@0 {

		main_af_endpoint: endpoint {
			remote-endpoint = <&main_af>;
		};
	};

	port@1 {

		main_af1_endpoint: endpoint {
			remote-endpoint = <&main_af1>;
		};
	};
};

&i2c5 {
	status = "okay";
	clock-frequency = <400000>;

	sensor1: sensor1 {
		compatible = "mediatek,imgsensor";
		#thermal-sensor-cells = <0>;
		reg = <0x1a>;
		pinctrl-names = "mclk_off", "mclk_2mA", "mclk_4mA", "mclk_6mA",
		                "mclk_8mA", "rst_low", "rst_high", "avdd_off",
		                "avdd_on", "dvdd_off", "dvdd_on";
		pinctrl-0 = <&camera_pins_cam1_mclk_off>;
		pinctrl-1 = <&camera_pins_cam1_mclk_2ma>;
		pinctrl-2 = <&camera_pins_cam1_mclk_4ma>;
		pinctrl-3 = <&camera_pins_cam1_mclk_6ma>;
		pinctrl-4 = <&camera_pins_cam1_mclk_8ma>;
		pinctrl-5 = <&camera_pins_cam1_rst_0>;
		pinctrl-6 = <&camera_pins_cam1_rst_1>;
		pinctrl-7 = <&camera_pins_cam1_vcama_0>;
		pinctrl-8 = <&camera_pins_cam1_vcama_1>;
		pinctrl-9 = <&camera_pins_cam1_vcamd_0>;
		pinctrl-10 = <&camera_pins_cam1_vcamd_1>;
		dovdd-supply = <&mt6359_vcamio_reg>;
		avdd1-supply = <&mt6359_vfe28_reg>;
		clocks = <&topckgen CLK_TOP_UNIVPLL_192M_D32>,
		         <&topckgen CLK_TOP_UNIVPLL_192M_D16>,
		         <&clk13m>,
		         <&topckgen CLK_TOP_UNIVPLL_192M_D8>,
		         <&clk26m>,
		         <&topckgen CLK_TOP_UNIVPLL_192M_D4>,
		         <&topckgen CLK_TOP_UNIVPLL_D6_D8>,
		         <&topckgen CLK_TOP_CAMTG2_SEL>;
		clock-names = "6", "12", "13", "24", "26", "48", "52", "mclk";
		status = "okay";

		port {

			sensor1_out: endpoint {
				remote-endpoint = <&seninf_csi_port_1_in>;
			};
		};
	};
};

&i2c6 {
	status = "okay";
	clock-frequency = <400000>;

	sensor0: sensor0 {
		compatible = "mediatek,imgsensor";
		#thermal-sensor-cells = <0>;
		reg = <0x1b>;
		pinctrl-names = "mclk_off", "mclk_2mA", "mclk_4mA", "mclk_6mA",
		                "mclk_8mA", "pdn_low", "pdn_high", "rst_low",
		                "rst_high", "avdd_off", "avdd_on", "dvdd_off",
		                "dvdd_on";
		pinctrl-0 = <&camera_pins_cam0_mclk_off>;
		pinctrl-1 = <&camera_pins_cam0_mclk_2ma>;
		pinctrl-2 = <&camera_pins_cam0_mclk_4ma>;
		pinctrl-3 = <&camera_pins_cam0_mclk_6ma>;
		pinctrl-4 = <&camera_pins_cam0_mclk_8ma>;
		pinctrl-5 = <&camera_pins_cam0_pnd_0>;
		pinctrl-6 = <&camera_pins_cam0_pnd_1>;
		pinctrl-7 = <&camera_pins_cam0_rst_0>;
		pinctrl-8 = <&camera_pins_cam0_rst_1>;
		pinctrl-9 = <&camera_pins_cam0_vcama_0>;
		pinctrl-10 = <&camera_pins_cam0_vcama_1>;
		pinctrl-11 = <&camera_pins_cam0_vcamd_0>;
		pinctrl-12 = <&camera_pins_cam0_vcamd_1>;
		dovdd-supply = <&mt6359_vcamio_reg>;
		afvdd-supply = <&mt6359_vibr_reg>;
		avdd1-supply = <&mt6359_vfe28_reg>;
		clocks = <&topckgen CLK_TOP_UNIVPLL_192M_D32>,
		         <&topckgen CLK_TOP_UNIVPLL_192M_D16>,
		         <&clk13m>,
		         <&topckgen CLK_TOP_UNIVPLL_192M_D8>,
		         <&clk26m>,
		         <&topckgen CLK_TOP_UNIVPLL_192M_D4>,
		         <&topckgen CLK_TOP_UNIVPLL_D6_D8>,
		         <&topckgen CLK_TOP_CAMTG_SEL>;
		clock-names = "6", "12", "13", "24", "26", "48", "52", "mclk";
		status = "okay";

		port {

			sensor0_out: endpoint {
				remote-endpoint = <&seninf_csi_port_0_in>;
			};
		};
	};
};
