		nvmem-cell-names = "hdmitx_phy_efuse";
		reg = <0 0x11d5f000 0 0x100>;
		clocks = <&infracfg_ao CLK_INFRA_AO_HDMI_26M>;
		clock-names = "hdmi_xtal_sel";
		clock-output-names = "hdmi_txpll";
		#clock-cells = <0>;
