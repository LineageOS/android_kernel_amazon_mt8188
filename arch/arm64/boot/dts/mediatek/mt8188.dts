	cqdma: cq_dma@10212000 {
		compatible = "mediatek,mt6765-cqdma", "mediatek,mt8188-cqdma";
		reg = <0 0x10212000 0 0x80 0 0x10212100 0 0x80 0 0x10212200 0 0x80 0 0x10212300 0 0x80>;
		interrupts = <GIC_SPI 186 IRQ_TYPE_LEVEL_HIGH 0>,
		             <GIC_SPI 187 IRQ_TYPE_LEVEL_HIGH 0>,
		             <GIC_SPI 188 IRQ_TYPE_LEVEL_HIGH 0>,
		             <GIC_SPI 189 IRQ_TYPE_LEVEL_HIGH 0>;
		dma-channels = <4>;
		dma-channel-mask = <0x3f>;
		clocks = <&infracfg_ao CLK_INFRA_AO_CQ_DMA>;
		clock-names = "cqdma";
	};

	emicen: emicen@10219000 {
		compatible = "mediatek,mt8188-emicen", "mediatek,common-emicen";
		reg = <0 0x10219000 0 0x1000 0 0x1021d000 0 0x1000>;
		mediatek,emi-reg = <&emichn>;
	};

	emimpu@10226000 {
		compatible = "mediatek,mt8188-emimpu", "mediatek,common-emimpu";
		reg = <0 0x10226000 0 0x1000 0 0x10225000 0 0x1000>;
		mediatek,emi-reg = <&emicen>;
		interrupts = <GIC_SPI 214 IRQ_TYPE_LEVEL_HIGH 0>;
		region_cnt = <32>;
		domain_cnt = <16>;
		addr_align = <0x10>;
		ap_region = <31>;
		ap_apc = <0 0 5 0 0 0 6 0 0 0 5 0 0 0 5 5>;
		dump = <496 504 508>;
		clear = <352 0xffffffff 16 512 3 16 496 0x80000000 1>;
		clear_md = <508 0x80000000 1>;
		ctrl_intf = <0x1>;
		slverr = <0>;
	};

	dramc@10230000 {
		compatible = "mediatek,mt8188-dramc", "mediatek,common-dramc";
		reg = <0 0x10230000 0 0x2000>,
		      <0 0x10240000 0 0x2000>,
		      <0 0x10250000 0 0x2000>,
		      <0 0x10260000 0 0x2000>,
		      <0 0x10234000 0 0x1000>,
		      <0 0x10244000 0 0x1000>,
		      <0 0x10254000 0 0x1000>,
		      <0 0x10264000 0 0x1000>,
		      <0 0x10238000 0 0x2000>,
		      <0 0x10248000 0 0x2000>,
		      <0 0x10258000 0 0x2000>,
		      <0 0x10268000 0 0x2000>,
		      <0 0x10236000 0 0x1000>,
		      <0 0x10246000 0 0x1000>,
		      <0 0x10256000 0 0x1000>,
		      <0 0x10266000 0 0x1000>,
		      <0 0x10006000 0 0x1000>;
		mr4_version = <1>;
		mr4_rg = <144 0xffff 0>;
		fmeter_version = <1>;
		crystal_freq = <52>;
		pll_id = <1292 256 8>;
		shu_lv = <1292 0x30000 16>;
		shu_of = <2304>;
		sdmpcw = <2308 (-65536) 16 2340 (-65536) 16>;
		prediv = <2312 0xc0000 18 2344 0xc0000 18>;
		posdiv = <2312 7 0 2344 7 0>;
		ckdiv4 = <3828 4 2 3828 4 2>;
		pll_md = <2304 1 0 2304 1 0>;
		cldiv2 = <2304 1 0 2304 1 0>;
