		              "aud_intbus_sel", "audio_h_sel", "audio_local_bus_sel", "dptx_m_sel",
		              "intdir_sel", "i2so1_m_sel", "i2so2_m_sel", "i2si1_m_sel",
		              "i2si2_m_sel", "mphone_slave_b", "infra_ao_audio_26m_b";
