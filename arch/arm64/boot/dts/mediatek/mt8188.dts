	pcie: pcie@112f0000 {
		device_type = "pci";
		compatible = "mediatek,mt8192-pcie", "mediatek,mt8188-pcie";
		reg = <0 0x112f0000 0 0x2000>;
		reg-names = "pcie-mac";
		linux,pci-domain = <0>;
		#address-cells = <3>;
		#size-cells = <2>;
		interrupts = <GIC_SPI 791 IRQ_TYPE_LEVEL_HIGH 0>;
		bus-range = <0 255>;
		ranges = <0x82000000 0 0x20000000 0 0x20000000 0 0x4000000>;
		iommu-map = <0 &infra_iommu 0x19 0xffff>;
		iommu-map-mask = <0>;
		status = "disabled";
		clocks = <&infracfg_ao CLK_INFRA_AO_PCIE_TL_26M>,
		         <&infracfg_ao CLK_INFRA_AO_PCIE_TL_96M>,
		         <&infracfg_ao CLK_INFRA_AO_PCIE_TL_32K>,
		         <&infracfg_ao CLK_INFRA_AO_PCIE_PERI_26M>,
		         <&pericfg_ao CLK_PERI_AO_PCIE_P0_FMEM>,
		         <&infracfg_ao CLK_INFRA_AO_PCIE_PL_P_250M_P0>;
		phys = <&pcieport 2>;
		phy-names = "pcie-phy";
		power-domains = <&spm MT8188_POWER_DOMAIN_PEXTP_MAC_P0>;
		#interrupt-cells = <1>;
		interrupt-map-mask = <0 0 0 0x7>;
		interrupt-map = <0 0 0 0x1 &pcie_intc 0 0 0
		                 0 0x2 &pcie_intc 0x1 0 0 0 0x3
		                 &pcie_intc 0x2 0 0 0 0x4 &pcie_intc 0x3>;

		pcie_intc: interrupt-controller {
			interrupt-controller;
			#address-cells = <0>;
			#interrupt-cells = <1>;
		};
	};

