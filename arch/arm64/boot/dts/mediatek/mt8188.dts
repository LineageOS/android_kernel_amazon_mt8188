			clock_buffer_ctrl: clock_buffer_ctrl {
				compatible = "mediatek,clock_buffer";
				n-clkbuf-pmic-dependent = <7>;
				clkbuf-pmic-dependent = "pmic-bblplm-hw", "pmic-bblpm-sel",
