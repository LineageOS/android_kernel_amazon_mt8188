	imgsys_fw: imgsys_fw@15000000 {
		compatible = "mediatek,imgsys";
		dma-ranges = <0x2 0 0 0x40000000 0x1 0>;
		reg = <0 0x15000000 0 0x4000>,
		      <0 0x15020000 0 0x10000>,
		      <0 0x15040000 0 0x10000>,
		      <0 0x15640000 0 0x10000>,
		      <0 0x15100000 0 0x10000>,
		      <0 0x15150000 0 0x10000>,
		      <0 0x15210000 0 0x10000>,
		      <0 0x15510000 0 0x10000>,
		      <0 0x15200000 0 0x10000>,
		      <0 0x15500000 0 0x10000>,
		      <0 0x15600000 0 0x10000>,
		      <0 0x15220000 0 0x100>,
		      <0 0x15320000 0 0x10000>,
		      <0 0 0 0x1000>,
		      <0 0 0 0x1000>,
		      <0 0x15520000 0 0x100>,
		      <0 0x15620000 0 0x100>,
		      <0 0x15110000 0 0x100>,
		      <0 0x15130000 0 0x100>;
		mediatek,hcp = <&hcp>;
		mediatek,larbs = <&larb9 &larb10 &larb11a &larb11b &larb11c &larb15>;
		iommus = <&vdo_iommu M4U_PORT_L9_IMGI_T1_A>,
		         <&vdo_iommu M4U_PORT_L9_UFDI_T1_A>,
		         <&vdo_iommu M4U_PORT_L9_IMGBI_T1_A>,
