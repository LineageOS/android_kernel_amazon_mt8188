				pmic-xo-mode = <1928 0 1928 3 1928 6 1928 9 0xffff 0xffff 1950 9 1950 12>;
				pmic-xo-en = <0x788 0x2 0x788 0x5 0x788 0x8 0x788 0xb 0xffff 0xffff 0x79e 0xb 0x79e 0xe>;
				pmic-bblpm-sw = <1928 12>;
