		status = "disabled";

		backlight {
			label = "lcd-backlight";
			pwms = <&disp_pwm0 0 500000>;
			max-brightness = <255>;
			default-state = "on";
			default-state-brightness = <76>;
			pwm-names = "lcd-backlight";
		};
	};

	reserved_memory: reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		aee_debug_kinfo: aee_debug_kinfo-reserve {
			compatible = "mediatek,aee_debug_kinfo";
			no-map;
			reg = <0 0x5fca0000 0 0x10000>;
		};

		wifi_mem: wifi-reserved-memory {
			compatible = "mediatek,wifi-reserved-memory";
			reusable;
			size = <0 0x500000>;
			alloc-ranges = <0x1 0x30000000 0 0x10000000>;
			alignment = <0 0x1000>;
		};

		reserve-memory-sspm_share {
			compatible = "mediatek,reserve-memory-sspm_share";
			no-map;
			status = "okay";
			size = <0 0x110000>;
			alignment = <0 0x10000>;
			alloc-ranges = <0x1 0x30000000 0 0x10000000>;
		};

		secure_wfd_reserved_memory: secure-wfd-reserved-memory {
			compatible = "shared-dma-pool";
			reusable;
			reg = <0 0xc0000000 0 0x5000000>;
		};

		secure_svp_reserved_memory: secure-svp-reserved-memory {
			compatible = "shared-dma-pool";
			reusable;
			reg = <0x1 0x38800000 0 0x7400000>;
		};
	};

