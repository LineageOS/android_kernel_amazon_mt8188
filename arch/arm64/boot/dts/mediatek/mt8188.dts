	systracker: systracker@10208000 {
		compatible = "mediatek,bus_dbg-v2";
		reg = <0 0x10208000 0 0x1000 0 0x10001000 0 0x1000>;
		mediatek,bus_dbg_con_offset = <764>;
		interrupts = <GIC_SPI 207 IRQ_TYPE_LEVEL_HIGH 0>;
	};

	infracfg@1020e000 {
