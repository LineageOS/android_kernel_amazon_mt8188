			         <&topckgen CLK_TOP_A2SYS_SEL>,
			         <&topckgen CLK_TOP_A3SYS_SEL>,
			         <&topckgen CLK_TOP_A4SYS_SEL>;
			clock-names = "asm_h_sel", "apll1", "apll2", "asrc0", "asrc1", "asrc2",
			              "asrc3", "a1sys_hp_sel", "a2sys_sel", "a3sys_sel", "a4sys_sel";
			status = "disabled";
