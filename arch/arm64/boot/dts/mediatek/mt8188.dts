		queue0 {
			snps,weight = <16>;
			snps,dcb-algorithm;
			snps,priority = <0>;
		};

		queue1 {
			snps,weight = <17>;
			snps,dcb-algorithm;
			snps,priority = <1>;
		};

		queue2 {
			snps,weight = <18>;
			snps,dcb-algorithm;
			snps,priority = <2>;
		};
	};

